#!/usr/bin/env bash
#
# Asserts the container is what it claims to be, then execs the real command.
#
# This exists because "the agent cannot touch your tenant" is the single claim
# the whole design rests on, and an unverified claim about identity has already
# cost this project a day (FINDINGS.md #2). A check that runs on every single
# invocation is cheap; discovering in month four that a stray AZURE_CLIENT_ID
# was being passed through is not.
#
# Fails loudly and refuses to start. There is no --force.

set -euo pipefail

fail=0
err() { echo "  [FAIL] $*" >&2; fail=1; }

echo "Verifying isolation..."

# 1. No tooling that can reach the cloud.
for forbidden in az terraform terragrunt pulumi aws gcloud; do
  if command -v "$forbidden" >/dev/null 2>&1; then
    err "\`$forbidden\` is present in this image. The agent must have no direct path to any cloud."
  fi
done

# 1b. No package installer. The harness and the validator need Python, and
#     Python can fetch anything, so this is not a boundary - but `pip install
#     azure-cli` was the one-line route to a cloud CLI, and the image is built
#     so that it does not exist. Assert that rather than trust it.
for installer in pip pip3 uv uvx; do
  if command -v "$installer" >/dev/null 2>&1; then
    err "\`$installer\` is present in this image. Dependencies are installed at build time from uv.lock; nothing installs at run time."
  fi
done
if python3 -m pip --version >/dev/null 2>&1; then
  err "\`python3 -m pip\` works. The venv is built without pip and python3-pip must not be installed."
fi

# 2. No credentials in the environment. Checked by prefix rather than by name,
#    because the failure mode is a variable nobody thought to list.
leaked=$(env | grep -Ei '^(AZURE_|ARM_|AAD_|MSI_|IDENTITY_|AWS_|GOOGLE_)' | cut -d= -f1 || true)
if [ -n "$leaked" ]; then
  err "cloud credentials are present in the environment: $(echo "$leaked" | tr '\n' ' ')"
  err "run.sh builds an explicit allowlist of variables - something is passing these through."
fi

# 3. No credential files mounted in.
for path in "$HOME/.azure" "$HOME/.aws" "$HOME/.config/gcloud"; do
  if [ -e "$path" ]; then
    err "$path exists inside the container. Nothing should be mounting it."
  fi
done

# 4. Not root. The CLI refuses to skip permission prompts under root, and the
#    resulting error points at Docker rather than at this Dockerfile. Assert it
#    here so the cause is named where the fix is.
if [ "$(id -u)" = "0" ]; then
  err "running as root. The Claude Code CLI will not start with permissions skipped as root - the Dockerfile must end with 'USER node'."
fi

# 5. The two things that must be present.
# Either credential is fine. The subscription token is the cheaper one for a
# POC; the API key is the one a product would have to use, because Anthropic
# restricts subscription OAuth to individual use. See the README.
if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
  auth="subscription (CLAUDE_CODE_OAUTH_TOKEN)"
elif [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  auth="API key (ANTHROPIC_API_KEY)"
else
  auth=""
  err "No Anthropic credential. Set CLAUDE_CODE_OAUTH_TOKEN (from \`claude setup-token\`) or ANTHROPIC_API_KEY."
fi
if [ -z "${GH_TOKEN:-}" ]; then
  err "GH_TOKEN is not set. The agent needs a token scoped to the deployments repo."
fi
if ! command -v claude >/dev/null 2>&1; then
  err "the Claude Code CLI is missing; the SDK cannot start a session without it."
fi
if ! command -v gh >/dev/null 2>&1; then
  err "gh is missing."
fi
# create-app needs the SDK. Its absence would otherwise surface as the agent
# being refused nothing and failing everything.
if ! command -v dotnet >/dev/null 2>&1; then
  err "dotnet is missing; the create-app runbook cannot be followed."
fi

# The harness imports the SDK from the venv uv built. If PATH does not put that
# venv first, python3 is Debian's and the failure is an ImportError at start.
if ! python3 -c 'import claude_agent_sdk, jsonschema' >/dev/null 2>&1; then
  err "python3 ($(command -v python3)) cannot import the harness dependencies; /opt/venv/bin must be first on PATH."
fi

# One run may not see another. With all of runs/ mounted, a run read an
# earlier run's workspace and copied its code (FINDINGS.md #23). run.sh mounts
# only this run's directory; assert that rather than trusting it.
if [ -d /work/runs ]; then
  others=$(find /work/runs -mindepth 1 -maxdepth 1 | wc -l)
  if [ "$others" -gt 1 ]; then
    err "/work/runs holds $others entries; only this run's directory may be mounted."
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "Refusing to start. The isolation this run depends on is not intact." >&2
  exit 1
fi

echo "  [ok]   no cloud CLI, no package installer, no cloud credentials, tokens present"
echo "  [ok]   Anthropic auth: ${auth}"
echo "  [ok]   .NET SDK $(dotnet --version 2>/dev/null)"
echo ""

exec "$@"
